
config globals
	option workgroup 'WORKGROUP'
	option description 'OpenWrt NAS'
	option interface 'lan tailscale'
	option allow_guest_ipc '0'
	option allow_legacy_protocols '0'

config share 'private'
	option name 'PRIVATE'
	option path '/mnt/private'
	option browseable 'yes'
	option read_only 'no'
	option users 'nas'
	option guest_ok 'no'
	option create_mask '0600'
	option dir_mask '0700'

config share 'nas'
	option name 'NAS1'
	option path '/mnt/nas'
	option browseable 'yes'
	option read_only 'no'
	option users 'nas'
	option guest_ok 'no'
	option create_mask '0600'
	option dir_mask '0700'

config share 'nas2'
	option name 'NAS2'
	option path '/mnt/nas2'
	option browseable 'yes'
	option read_only 'no'
	option users 'nas'
	option guest_ok 'no'
	option create_mask '0600'
	option dir_mask '0700'
