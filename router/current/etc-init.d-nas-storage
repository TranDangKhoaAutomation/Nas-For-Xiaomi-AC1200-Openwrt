#!/bin/sh /etc/rc.common
USE_PROCD=1

START=97
STOP=04

start_service() {
    # Never expose /mnt/nas from router flash while no real storage is mounted.
    /etc/init.d/ksmbd stop >/dev/null 2>&1

    procd_open_instance
    procd_set_param command /usr/sbin/nas-storage-manager watch
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}

stop_service() {
    /usr/sbin/nas-storage-manager eject >/dev/null 2>&1 || true
}
