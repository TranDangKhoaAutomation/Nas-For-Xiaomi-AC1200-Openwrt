
config globals
	option workgroup 'WORKGROUP'
	option description 'OpenWrt NAS - AutoUnlock ON'
	option interface 'lan tailscale'

config share 'nas'
	option name 'NAS1'
	option path '/mnt/nas'
	option read_only 'no'
	option users 'nas'
	option guest_ok 'no'
	option create_mask '0600'
	option dir_mask '0700'
	option browseable 'yes'

config share 'nas2'
	option name 'NAS2'
	option path '/mnt/nas2'
	option read_only 'no'
	option users 'nas'
	option guest_ok 'no'
	option create_mask '0600'
	option dir_mask '0700'
	option browseable 'yes'

config share 'private'
	option name 'PRIVATE'
	option path '/mnt/private'
	option browseable 'yes'
	option read_only 'no'
	option users 'nas'
	option guest_ok 'no'
	option create_mask '0600'
	option dir_mask '0700'
